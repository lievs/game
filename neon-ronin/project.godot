; Engine configuration file.
; It's best edited using the editor UI and not directly, since the parameters
; that go here are not all obvious.

config_version=5

[application]

config/name="Neon Ronin"
config/description="Кибер-самурай в неоновой башне. Держи палец на экране — беги и уклоняйся. Отпусти — руби катаной."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/handheld/orientation="portrait"
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"

[rendering]

renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.01, 0.01, 0.03, 1)
